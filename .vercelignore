# Vercel Deployment Ignore
# Exclude heavy offline documentation and raw backups
docs/
backup_prod_*/
scratch/

# Exclude local test suites from serverless upload
tests/

# Keep Supabase source modules (lib/supabase/) available to the build.
# Migration scripts are small; excluding "supabase/" would also remove
# runtime imports in some Vercel ignore matching contexts.

# Exclude AI agent and IDE working configurations
.agents/
.codex/
.gemini/

# Exclude raw 3D assets and video formats not used in web runtime
*.blend
*.blend1
*.webm
