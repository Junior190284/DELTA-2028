# ========================================================
# DELTA 2018 GM — STAGING ENVIRONMENT CONFIGURATION
# ========================================================
# Skopiuj ten plik do .env.staging.local lub wklej do Vercel Preview/Staging

# 1. Staging Supabase Credentials (z nowego projektu delta-2018-gm-staging)
NEXT_PUBLIC_SUPABASE_URL=https://<staging-project-id>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_<staging-key>
SUPABASE_SERVICE_ROLE_KEY=sb_secret_<staging-secret-key>

# 2. Web Push (Staging VAPID Keys — odizolowane od produkcji)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:staging-test@delta2018.pl

# 3. App URLs & Secret Sync
DELTA_SYNC_SECRET=staging_secret_sync_token_2018
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000
